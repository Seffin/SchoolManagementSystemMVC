@model List<SchoolManagementSystemMVC.Models.Student>

@{
    ViewData["Title"] = "Students List";
}

<div class="container mt-4">
    <h2>Registered Students</h2>
    <hr />

    <div class="mb-3">
        <a href="/Student/Register" class="btn btn-primary">Register New Student</a>
        <a href="/Account/Login" class="btn btn-secondary">Logout</a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Username</th>
                        <th>Qualifications</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FirstName @student.LastName</td>
                            <td>@student.Age</td>
                            <td>@student.Gender</td>
                            <td>@student.Email</td>
                            <td>@student.Phone</td>
                            <td>@student.Username</td>
                            <td>
                                @if (student.Qualifications != null && student.Qualifications.Any())
                                {
                                    <ul class="list-unstyled">
                                        @foreach (var qual in student.Qualifications)
                                        {
                                            <li>@qual.CourseName - @qual.University (@qual.YearOfPassing) - @qual.Percentage%</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">No qualifications</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No students registered yet. <a href="/Student/Register">Register first student</a>
        </div>
    }
</div>